{
  "name": "@phonics/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/src/main.js\"",
    "build": "prisma generate && tsc",
    "typecheck": "prisma generate && tsc --noEmit",
    "start": "node dist/src/main.js",
    "test": "pnpm build && node --test dist/test/unit.test.js",
    "test:integration": "pnpm build && node --test dist/test/integration.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node dist/src/adapters/persistence/postgres/seed.js",
    "db:init": "pnpm build && node dist/src/adapters/persistence/dynamo/init.js"
  },
  "dependencies": {
    "@phonics/shared": "workspace:*",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "dynamoose": "4.2.0",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "@types/express": "^5.0.3",
    "concurrently": "^9.2.1"
  }
}
